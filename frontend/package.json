{
  "name": "wordbomb",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test tests/*.test.ts",
    "party:check": "node scripts/check-party-build.mjs",
    "check": "npm run typecheck && npm run lint && npm run test && npm run party:check",
    "party:dev": "wrangler dev --port 1999",
    "party:deploy": "wrangler deploy"
  },
  "dependencies": {
    "next": "^14.2.0",
    "partyserver": "^0.0.49",
    "partysocket": "^1.3.0",
    "react": "^18.3.0",
    "react-dom": "^18.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "autoprefixer": "^10.4.0",
    "esbuild": "^0.28.2",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.35",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "tsx": "^4.23.13",
    "typescript": "^5.3.0",
    "wrangler": "^3.114.17"
  },
  "engines": {
    "node": ">=18.17"
  }
}
