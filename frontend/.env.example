# ─────────────────────────────────────────────────────────────
# Next.js frontend
# ─────────────────────────────────────────────────────────────
# Hostname only — no wss:// or https:// prefix.
# Dev: localhost:1999 | Prod: wordbomb.<username>.partykit.dev
NEXT_PUBLIC_PARTYKIT_HOST=localhost:1999

# Optional. Absolute base URL used to resolve the OpenGraph/Twitter card.
# Vercel sets VERCEL_URL automatically, so this is only needed for a custom domain.
# NEXT_PUBLIC_SITE_URL=https://wordbomb.example.com

# ─────────────────────────────────────────────────────────────
# PartyKit realtime server
# ─────────────────────────────────────────────────────────────
# Optional — enables AI opponents. Get one at https://console.groq.com/keys
#
# IMPORTANT: lib/ai-service.ts runs inside the PartyKit worker, NOT on Vercel.
#   Local dev  -> this file (partykit dev loads .env.local automatically)
#   Production -> npx partykit env add GROQ_API_KEY
# Setting it in the Vercel dashboard has no effect; AI moves will silently fall
# back to the offline word list.
GROQ_API_KEY=your_groq_api_key_here
